<?xml version="1.0"?>
<form col="4">
    <button name="new_version" string="New Version" colspan="4"/>
    <label name="scheme"/>
    <field name="scheme"/>
    <label name="version"/>
    <field name="version" readonly="1"/>
    <label name="certificate_number"/>
    <field name="certificate_number" readonly="1"/>
    <label name="issuer"/>
    <field name="issuer" readonly="1"/>
    <label name="issue_date"/>
    <field name="issue_date" readonly="1"/>
    <label name="expiry_date"/>
    <field name="expiry_date" readonly="1"/>
    <label name="expired"/>
    <field name="expired"/>
    <label name="request_update"/>
    <field name="request_update"/>
    <separator string="Scope" id="scope" colspan="4"/>
    <field name="scope_text" colspan="4" readonly="1"/>
    <field name="versions" colspan="4"
        view_ids="supplier_compliance.certificate_version_view_tree,supplier_compliance.certificate_version_view_form"/>
</form>
